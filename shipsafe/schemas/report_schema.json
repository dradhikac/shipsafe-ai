{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShipSafe Release Report",
  "description": "Common schema for ShipSafe AI release analysis reports.",
  "type": "object",
  "required": ["report_type", "generated_at", "status", "summary", "findings", "metrics"],
  "additionalProperties": true,

  "properties": {
    "report_type": {
      "type": "string",
      "description": "Identifies the kind of report: base_analysis, agent_report, or synthesized_report."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when the report was generated."
    },
    "status": {
      "type": "string",
      "enum": ["RELEASE_READY", "NEEDS_ATTENTION", "RELEASE_BLOCKED", "ANALYSIS_ONLY"],
      "description": "Overall release status determined by this report."
    },
    "summary": {
      "type": "object",
      "description": "High-level summary fields.",
      "properties": {
        "total_findings": {"type": "integer", "minimum": 0},
        "critical_count": {"type": "integer", "minimum": 0},
        "high_count": {"type": "integer", "minimum": 0},
        "medium_count": {"type": "integer", "minimum": 0},
        "low_count": {"type": "integer", "minimum": 0},
        "info_count": {"type": "integer", "minimum": 0},
        "requirements_compliant": {"type": "integer", "minimum": 0},
        "requirements_non_compliant": {"type": "integer", "minimum": 0},
        "requirements_unverifiable": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "description": "List of findings. May be empty on a clean baseline.",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "metrics": {
      "$ref": "#/definitions/metrics"
    },
    "repository": {
      "type": "object",
      "description": "Repository metadata.",
      "properties": {
        "repo_root": {"type": "string"},
        "branch": {"type": "string"},
        "head_commit": {"type": "string"},
        "head_message": {"type": "string"},
        "is_clean": {"type": "boolean"}
      }
    },
    "git": {
      "type": "object",
      "description": "Git change details.",
      "properties": {
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {"type": "string"},
              "path": {"type": "string"},
              "old_path": {"type": ["string", "null"]}
            }
          }
        },
        "diff_summary": {
          "type": "object",
          "properties": {
            "files_changed": {"type": "integer", "minimum": 0},
            "lines_added": {"type": "integer", "minimum": 0},
            "lines_deleted": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "description": "Loaded release requirements.",
      "items": {
        "type": "object",
        "required": ["requirement_id", "requirement_text"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^R\\d{3}$"},
          "requirement_text": {"type": "string", "minLength": 1},
          "source_file": {"type": "string"}
        }
      }
    },
    "test_analysis": {
      "type": "object",
      "description": "Test execution results.",
      "properties": {
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "passed": {"type": "boolean"},
        "total": {"type": ["integer", "null"]},
        "passed_count": {"type": ["integer", "null"]},
        "failed_count": {"type": ["integer", "null"]},
        "skipped_count": {"type": ["integer", "null"]},
        "error_count": {"type": ["integer", "null"]},
        "duration_seconds": {"type": ["number", "null"]},
        "coverage": {
          "type": "object",
          "properties": {
            "available": {"type": "boolean"},
            "total_percent": {"type": ["number", "null"]},
            "statements": {"type": ["integer", "null"]},
            "missed": {"type": ["integer", "null"]}
          }
        }
      }
    }
  },

  "definitions": {
    "finding": {
      "type": "object",
      "required": ["finding_id", "severity", "title", "finding_status", "source_agent"],
      "properties": {
        "finding_id": {
          "type": "string",
          "description": "Unique identifier for this finding, e.g. SECURITY-001."
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
        },
        "finding_status": {
          "type": "string",
          "enum": ["CONFIRMED", "WARNING", "INFORMATIONAL"]
        },
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "requirement_id": {
          "type": ["string", "null"],
          "description": "The release requirement this finding relates to, if any."
        },
        "affected_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "array",
          "description": "Evidence supporting this finding. Required for CONFIRMED findings.",
          "items": {"$ref": "#/definitions/evidence_item"}
        },
        "recommended_action": {"type": "string"},
        "source_agent": {
          "type": "string",
          "description": "Which agent or component produced this finding."
        }
      },
      "if": {
        "properties": {"finding_status": {"const": "CONFIRMED"}}
      },
      "then": {
        "properties": {
          "evidence": {"type": "array", "minItems": 1}
        },
        "required": ["evidence"]
      }
    },

    "evidence_item": {
      "type": "object",
      "required": ["evidence_type", "description"],
      "properties": {
        "evidence_type": {
          "type": "string",
          "enum": ["CODE", "TEST_FAILURE", "COMMAND_OUTPUT", "FILE_PRESENCE",
                   "GIT_CHANGE", "REQUIREMENT_GAP", "SCHEMA_CHANGE"]
        },
        "description": {"type": "string", "minLength": 1},
        "file_path": {"type": ["string", "null"]},
        "line_start": {"type": ["integer", "null"]},
        "line_end": {"type": ["integer", "null"]},
        "symbol": {"type": ["string", "null"]},
        "requirement_id": {"type": ["string", "null"]},
        "test_name": {"type": ["string", "null"]},
        "command": {"type": ["array", "null"], "items": {"type": "string"}},
        "output": {"type": ["string", "null"]},
        "is_concrete": {"type": "boolean"}
      }
    },

    "metrics": {
      "type": "object",
      "description": "Measured metrics for this analysis run.",
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "git_branch": {"type": ["string", "null"]},
        "git_commit": {"type": ["string", "null"]},
        "is_clean": {"type": ["boolean", "null"]},
        "files_changed": {"type": ["integer", "null"]},
        "lines_added": {"type": ["integer", "null"]},
        "lines_deleted": {"type": ["integer", "null"]},
        "tests_total": {"type": ["integer", "null"]},
        "tests_passed": {"type": ["integer", "null"]},
        "tests_failed": {"type": ["integer", "null"]},
        "tests_skipped": {"type": ["integer", "null"]},
        "tests_errors": {"type": ["integer", "null"]},
        "test_duration_seconds": {"type": ["number", "null"]},
        "coverage_available": {"type": "boolean"},
        "coverage_percent": {"type": ["number", "null"]},
        "coverage_statements": {"type": ["integer", "null"]},
        "coverage_missed": {"type": ["integer", "null"]}
      }
    }
  }
}
