# ShipSafe AI V2 Configuration

# AI Provider Configuration
AI_PROVIDER=grok
XAI_MODEL=grok-4.7
XAI_API_KEY=your_xai_api_key_here

# Database Configuration (SQLite locally, PostgreSQL in production)
DATABASE_URL=sqlite:///./shipsafe.db
# DATABASE_URL=postgresql://user:password@localhost:5432/shipsafe

# GitHub Webhook Security
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Optional GitHub token for private repositories or status checks
GITHUB_TOKEN=your_github_personal_access_token_here

# Application Environment (development, testing, production)
APP_ENV=development
API_BASE_URL=http://localhost:8000
